# Copy this file to .env.local and fill it in. Never commit real values: this repo is public.

# Postgres connection string.
# - Local Docker database (`pnpm db:up`): use the value below.
# - Neon: paste the connection string from the Neon dashboard. A *.neon.tech host automatically
#   uses the Neon driver (see src/db/client.ts); every other host uses the normal Postgres driver.
DATABASE_URL=postgres://momsbloom:momsbloom@localhost:5432/momsbloom

# Extra sites that may show /embed in an iframe, separated by spaces. Only for local tests
# (Playwright sets it for you). Leave it empty on Vercel.
EMBED_EXTRA_FRAME_ANCESTORS=

# --- Admin login (ADR 0003) ---

# Signs the Auth.js cookies and keys the rate limit. Make one with: openssl rand -base64 32
AUTH_SECRET=

# Local and Playwright only: `next start` does not trust the request host. Do NOT set it on Vercel
# (Auth.js trusts the host there, so each Preview gets links to itself).
AUTH_URL=http://localhost:3000

# Resend API key. Empty: the Login link prints in the dev server log (refused on Vercel).
RESEND_API_KEY=
EMAIL_FROM="MomsBloom Resources" <no-reply@momsbloom.org>

# Staff admin allow-list, separated by commas. Only these addresses can get a Login link.
# Never commit real addresses: this repo is public.
ADMIN_EMAILS=

# Microsoft 365 login comes later (ADR 0003).
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=
