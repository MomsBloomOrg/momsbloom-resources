# Copy this file to .env.local and fill it in. Never commit real values: this repo is public.

# Postgres connection string.
# - Local Docker database (`pnpm db:up`): use the value below.
# - Neon: paste the connection string from the Neon dashboard. A *.neon.tech host automatically
#   uses the Neon driver (see src/db/client.ts); every other host uses the normal Postgres driver.
DATABASE_URL=postgres://momsbloom:momsbloom@localhost:5432/momsbloom

# Extra sites that may show /embed in an iframe, separated by spaces. Only for local tests
# (Playwright sets it for you). Leave it empty on Vercel.
EMBED_EXTRA_FRAME_ANCESTORS=
